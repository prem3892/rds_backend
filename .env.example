# Server Configuration
PORT=5000
NODE_ENV=local

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/nestjs_chat_app

# JWT Configuration
JWT_SECRET=yourSecretKey
JWT_EXPIRES_IN=1d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Application Configuration
APP_DOMAIN=localhost:3000
INTERNAL_BASE_URL=http://localhost:8888

# Chat Configuration
CHAT_FIRST_ALERT_THRESHOLD_MS=60000
CHAT_SUBSEQUENT_ALERT_INTERVAL_MS=90000
CHAT_MAX_PRIORITY_ALERTS=3
AGENT_RECONNECT_TIMEOUT_MS=120000
CUSTOMER_RECONNECT_TIMEOUT_MS=300000
CUSTOMER_ABANDON_TIMEOUT_MS=900000

# Visitor Tracking Configuration
VISITOR_REDIS_TTL_SECONDS=1800
VISITOR_CLEANUP_INTERVAL_MS=120000
VISITOR_GRACE_PERIOD_MS=300000
MAX_VISITORS_PER_AGENT=1000
VISITOR_DELTA_UPDATES=true

# Mail Configuration
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@yourapp.com